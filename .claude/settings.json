{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/capture.mjs", "prompt"],
            "timeout": 15,
            "statusMessage": "Capturing prompt to .agent-logs/"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/capture.mjs", "response"],
            "timeout": 30,
            "statusMessage": "Capturing response to .agent-logs/"
          }
        ]
      }
    ]
  }
}
