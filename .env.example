# =============================================================================
# Cue — environment
#
# Copy to .env.local and fill in. Everything here is read at build time for the
# NEXT_PUBLIC_* values, so change one and restart the dev server.
# =============================================================================

# ---------------------------------------------------------------- Supabase --
# Supabase dashboard -> Project Settings -> API.
# Leave both blank and the app runs on in-memory fixtures instead, so the demo
# still works before the backend exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security -- never expose this to the browser.
# Needed by scripts/seed.ts. Sign-in and the app work without it.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Site --
# The origin this deployment is served from. Used for canonical URLs, the
# sitemap and Open Graph images.
#
# Set it to the real origin in production. Left blank, it falls back to
# Vercel's own deployment URL and then to localhost -- which is correct
# locally and wrong on a live site, where it would point search engines and
# link previews at a developer's machine.
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------- Google OAuth --
# "true" turns on the real Google round trip. Off by default: Google blocks
# unverified apps for anyone who is not an added test user, so a visitor who is
# not one gets stranded on Google's own domain. Email and password has no such
# gate and is the primary path.
#
# Cue asks for openid/email/profile only -- no calendar, no offline access.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=

# =============================================================================
# Email verification
#
# There is nothing to put in this file for it, and that is worth stating
# plainly rather than leaving you to discover it: Supabase sends the
# confirmation email, not this application. The settings below live in the
# Supabase dashboard.
#
# 1. SMTP — Authentication -> Emails -> SMTP Settings
#
#    Supabase's built-in sender is rate limited to a handful of messages per
#    hour across the whole project and is frequently filtered as spam. It is
#    for development only. For anything a real person will use, point it at a
#    provider you control:
#
#      Host        smtp.resend.com          (or your provider)
#      Port        465
#      Username    resend
#      Password    <your provider's API key>
#      Sender      a verified address on a domain you own
#
#    Until this is set, "the code never arrived" is the expected behaviour
#    rather than a bug.
#
# 2. The code itself — Authentication -> Emails -> Templates -> Confirm signup
#
#    The default template only contains a link. To make the six-digit code in
#    the app work, the template must also include the token:
#
#      <p>Your Cue verification code is <strong>{{ .Token }}</strong></p>
#      <p>Or <a href="{{ .ConfirmationURL }}">confirm here</a>.</p>
#
#    The app accepts either -- typing the code, or following the link.
#
# 3. Redirect URLs — Authentication -> URL Configuration
#
#    Add every origin you sign in from (localhost, previews, production) to
#    "Redirect URLs", and set "Site URL" to production. When an origin is
#    missing, Supabase silently substitutes the Site URL, and the link in the
#    email lands on a different deployment.
#
#    The typed code does not depend on any of this, which is why it exists.
# =============================================================================

# -------------------------------------------------------------------- Zoom --
# Optional. Only needed for real Zoom recording access; without it the Zoom
# card links out to Zoom's own sign-up.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
