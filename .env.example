# ---------------------------------------------------------------- Supabase --
# From the Supabase dashboard: Project Settings -> API.
# Leave these blank and the app runs on in-memory fixtures instead, so the
# demo still works before the backend is set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security -- never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build OAuth redirect URLs. Set to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------------- Zoom --
# Optional. A Zoom OAuth app is only needed for real Zoom recording access;
# without it the Zoom card links out to Zoom's own sign-up.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
